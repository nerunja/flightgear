!/photoscenery/16k-px/Orthophotos/
/photoscenery/16k-px/Orthophotos/*
!/photoscenery/16k-px/Orthophotos/w080n40/
!/photoscenery/16k-px/Orthophotos/w130n30/
photoscenery/**/*.png
